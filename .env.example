# Google Apps Script web app URL baked into the build (Vite + Netlify).
# Copy to .env.production for local production builds, or set the same key
# in Netlify → Environment variables. The Sheets / Sync button remains in the UI.
#
# VITE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shared login password. Leave unset/empty for no login gate (typical local dev).
# Set the same key in Netlify → Environment variables for production.
# Warning: Vite embeds VITE_* values in the client JS — casual shared gate only.
#
# VITE_APP_PASSWORD=your-shared-password
